<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phantom Activity - Remote Control</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1a2845 100%);
            min-height: 100vh;
            padding: 20px;
            color: #e0e7ff;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 40px;
            padding: 30px 20px;
            background: rgba(30, 41, 59, 0.8);
            border-radius: 12px;
            border: 1px solid rgba(148, 163, 184, 0.2);
            backdrop-filter: blur(10px);
        }

        h1 {
            font-size: 32px;
            font-weight: 600;
            margin-bottom: 8px;
            background: linear-gradient(135deg, #60a5fa 0%, #34d399 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtitle {
            color: #94a3b8;
            font-size: 14px;
            font-weight: 500;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        @media (max-width: 640px) {
            .grid {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 12px;
            padding: 24px;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .card:hover {
            border-color: rgba(148, 163, 184, 0.4);
            background: rgba(30, 41, 59, 0.8);
        }

        .card h2 {
            font-size: 18px;
            margin-bottom: 16px;
            color: #60a5fa;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-indicator {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #ef4444;
            animation: pulse 2s infinite;
        }

        .status-indicator.active {
            background: #10b981;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .status-value {
            font-size: 24px;
            font-weight: 600;
            color: #e0e7ff;
            margin: 12px 0;
        }

        .status-meta {
            font-size: 13px;
            color: #94a3b8;
            margin: 8px 0;
        }

        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        button {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
        }

        .btn-primary:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(16, 185, 129, 0.3);
        }

        .btn-primary:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-danger {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
        }

        .btn-danger:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 8px 16px rgba(239, 68, 68, 0.3);
        }

        .btn-secondary {
            background: rgba(148, 163, 184, 0.2);
            color: #cbd5e1;
            border: 1px solid rgba(148, 163, 184, 0.3);
        }

        .btn-secondary:hover:not(:disabled) {
            background: rgba(148, 163, 184, 0.3);
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .mode-selector {
            display: flex;
            gap: 10px;
            margin-top: 12px;
        }

        .mode-btn {
            flex: 1;
            padding: 10px;
            background: rgba(96, 165, 250, 0.1);
            border: 1px solid rgba(96, 165, 250, 0.3);
            border-radius: 6px;
            color: #93c5fd;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 12px;
            font-weight: 500;
        }

        .mode-btn:hover {
            background: rgba(96, 165, 250, 0.2);
            border-color: rgba(96, 165, 250, 0.6);
        }

        .mode-btn.active {
            background: rgba(96, 165, 250, 0.3);
            border-color: #60a5fa;
            color: #60a5fa;
        }

        .logs-container {
            background: rgba(15, 23, 42, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 8px;
            padding: 16px;
            max-height: 300px;
            overflow-y: auto;
            font-family: 'Monaco', 'Courier New', monospace;
            font-size: 12px;
        }

        .log-entry {
            padding: 6px 0;
            border-bottom: 1px solid rgba(148, 163, 184, 0.1);
            color: #cbd5e1;
        }

        .log-entry:last-child {
            border-bottom: none;
        }

        .log-time {
            color: #60a5fa;
            margin-right: 12px;
        }

        .log-message {
            color: #94a3b8;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 6px;
            margin-bottom: 12px;
            font-size: 13px;
        }

        .alert-success {
            background: rgba(16, 185, 129, 0.1);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #6ee7b7;
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
        }

        .alert-info {
            background: rgba(96, 165, 250, 0.1);
            border: 1px solid rgba(96, 165, 250, 0.3);
            color: #93c5fd;
        }

        .refresh-btn {
            background: rgba(148, 163, 184, 0.2);
            border: 1px solid rgba(148, 163, 184, 0.3);
            color: #cbd5e1;
            padding: 8px 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.2s ease;
        }

        .refresh-btn:hover {
            background: rgba(148, 163, 184, 0.3);
        }

        .full-width {
            grid-column: 1 / -1;
        }

        .config-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            font-size: 13px;
            margin-top: 12px;
        }

        .config-item {
            padding: 12px;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 6px;
            border: 1px solid rgba(148, 163, 184, 0.1);
        }

        .config-label {
            color: #94a3b8;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .config-value {
            color: #e0e7ff;
            font-weight: 500;
        }

        footer {
            text-align: center;
            margin-top: 40px;
            padding: 20px;
            color: #64748b;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>[WEB] Phantom Activity Remote Control</h1>
            <p class="subtitle">Manage your farm activity from anywhere</p>
        </header>

        <div id="alerts"></div>

        <div class="grid">
            <!-- Status Card -->
            <div class="card">
                <h2><span class="status-indicator" id="statusIndicator"></span> [STATUS] System</h2>
                <div class="status-value" id="statusText">Loading...</div>
                <div class="status-meta">Mode: <span id="modeText">--</span></div>
                <div class="status-meta">Uptime: <span id="uptimeText">--</span></div>
                <div class="status-meta">Last Update: <span id="lastUpdateText">--</span></div>
            </div>

            <!-- Control Card -->
            <div class="card">
                <h2>[CTRL] Controls</h2>

                <div class="mode-selector">
                    <button class="mode-btn active" data-mode="standard">Standard</button>
                    <button class="mode-btn" data-mode="extended">Extended</button>
                </div>

                <div class="button-group" style="margin-top: 16px;">
                    <button class="btn-primary" id="startBtn" onclick="startActivity()">
                        START
                    </button>
                    <button class="btn-danger" id="stopBtn" onclick="stopActivity()" disabled>
                        STOP
                    </button>
                </div>
            </div>

            <!-- System Info -->
            <div class="card">
                <h2>[INFO] System Info</h2>
                <div id="systemInfo" style="font-size: 13px;">
                    <div class="status-meta">Status: <span id="healthText">Checking...</span></div>
                    <div class="status-meta">PowerShell: <span id="psVersionText">--</span></div>
                    <div class="status-meta">Free Disk: <span id="diskFreeText">--</span> GB</div>
                </div>
            </div>

            <!-- Configuration -->
            <div class="card">
                <h2>[CFG] Configuration</h2>
                <div class="config-grid" id="configGrid">
                    <div class="config-item">
                        <div class="config-label">Working Hours</div>
                        <div class="config-value">8:25 - 18:58</div>
                    </div>
                    <div class="config-item">
                        <div class="config-label">Lunch Break</div>
                        <div class="config-value">13:00 - 13:30</div>
                    </div>
                </div>
            </div>

            <!-- Recent Logs -->
            <div class="card full-width">
                <h2>
                    [LOG] Recent Activity
                    <button class="refresh-btn" onclick="loadLogs()" title="Refresh logs">REFRESH</button>
                </h2>
                <div class="logs-container" id="logsContainer">
                    <div class="log-entry">
                        <span class="log-time">Loading...</span>
                    </div>
                </div>
            </div>
        </div>

        <footer>
            <p>Phantom Activity System v4.0 - Web Interface - Secure Remote Control</p>
        </footer>
    </div>

    <script>
        const API_KEY = new URLSearchParams(window.location.search).get('key') || '';
        const API_BASE = '/api';
        let selectedMode = 'standard';
        let autoRefreshInterval = null;

        // Mode selector
        document.querySelectorAll('.mode-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                selectedMode = this.dataset.mode;
            });
        });

        // Alert system
        function showAlert(message, type = 'info') {
            const alertsDiv = document.getElementById('alerts');
            const alert = document.createElement('div');
            alert.className = `alert alert-${type}`;
            alert.textContent = message;
            alertsDiv.appendChild(alert);
            setTimeout(() => alert.remove(), 5000);
        }

        // Start activity
        async function startActivity() {
            try {
                const response = await fetch(`${API_BASE}/start?mode=${selectedMode}${API_KEY ? '&key=' + API_KEY : ''}`);
                const data = await response.json();

                if (data.Success) {
                    showAlert(`[OK] Activity started (${selectedMode} mode)`, 'success');
                    updateStatus();
                } else {
                    showAlert(`[ERROR] ${data.Error}`, 'error');
                }
            } catch (error) {
                showAlert(`[ERROR] Connection error: ${error.message}`, 'error');
            }
        }

        // Stop activity
        async function stopActivity() {
            if (!confirm('Stop phantom activity?')) return;

            try {
                const response = await fetch(`${API_BASE}/stop${API_KEY ? '?key=' + API_KEY : ''}`);
                const data = await response.json();

                if (data.Success) {
                    showAlert('[OK] Activity stopped', 'success');
                    updateStatus();
                } else {
                    showAlert(`[ERROR] ${data.Error}`, 'error');
                }
            } catch (error) {
                showAlert(`[ERROR] Connection error: ${error.message}`, 'error');
            }
        }

        // Update status
        async function updateStatus() {
            try {
                const response = await fetch(`${API_BASE}/status${API_KEY ? '?key=' + API_KEY : ''}`);
                const data = await response.json();

                const indicator = document.getElementById('statusIndicator');
                const statusText = document.getElementById('statusText');

                if (data.Status === 'running') {
                    indicator.classList.add('active');
                    statusText.textContent = '[RUNNING]';
                } else {
                    indicator.classList.remove('active');
                    statusText.textContent = '[STOPPED]';
                }

                document.getElementById('modeText').textContent = data.Mode.toUpperCase() || '--';
                document.getElementById('uptimeText').textContent = data.Uptime || '--';

                const lastUpdate = new Date(data.LastUpdate);
                document.getElementById('lastUpdateText').textContent = lastUpdate.toLocaleTimeString();

                document.getElementById('startBtn').disabled = data.Status === 'running';
                document.getElementById('stopBtn').disabled = data.Status === 'stopped';

                loadHealth();
                loadConfig();
            } catch (error) {
                showAlert(`[WARN] Failed to update status`, 'info');
            }
        }

        // Load system health
        async function loadHealth() {
            try {
                const response = await fetch(`${API_BASE}/health${API_KEY ? '?key=' + API_KEY : ''}`);
                const data = await response.json();

                document.getElementById('healthText').textContent = '[OK] Online';
                document.getElementById('psVersionText').textContent = data.PowerShell || '--';
                document.getElementById('diskFreeText').textContent = data.DiskFree || '--';
            } catch (error) {
                document.getElementById('healthText').textContent = '[ERROR] Offline';
            }
        }

        // Load configuration
        async function loadConfig() {
            try {
                const response = await fetch(`${API_BASE}/config${API_KEY ? '?key=' + API_KEY : ''}`);
                const config = await response.json();

                const configGrid = document.getElementById('configGrid');
                configGrid.innerHTML = `
                    <div class="config-item">
                        <div class="config-label">Working Hours</div>
                        <div class="config-value">${config.ActiveStartHour}:${String(config.ActiveStartMinuteMin).padStart(2, '0')} - ${config.ActiveEndHour}:${String(config.ActiveEndMinuteMin).padStart(2, '0')}</div>
                    </div>
                    <div class="config-item">
                        <div class="config-label">Lunch Break</div>
                        <div class="config-value">${config.LunchStartHour}:${String(config.LunchStartMinuteMin).padStart(2, '0')} - ${config.LunchEndHour}:${String(config.LunchEndMinuteMin).padStart(2, '0')}</div>
                    </div>
                    <div class="config-item">
                        <div class="config-label">Cycle Duration</div>
                        <div class="config-value">${config.StayOpenSeconds}s</div>
                    </div>
                    <div class="config-item">
                        <div class="config-label">Working Days</div>
                        <div class="config-value">${config.ActiveDays.length} days</div>
                    </div>
                `;
            } catch (error) {
                // Ignore config errors
            }
        }

        // Load logs
        async function loadLogs() {
            try {
                const response = await fetch(`${API_BASE}/logs${API_KEY ? '?key=' + API_KEY : ''}`);
                const data = await response.json();

                const logsContainer = document.getElementById('logsContainer');
                logsContainer.innerHTML = '';

                if (data.Logs && data.Logs.length > 0) {
                    data.Logs.forEach(log => {
                        const entry = document.createElement('div');
                        entry.className = 'log-entry';
                        entry.innerHTML = `<span class="log-time">${new Date(log.Time).toLocaleTimeString()}</span><span class="log-message">${escapeHtml(log.Message)}</span>`;
                        logsContainer.appendChild(entry);
                    });
                } else {
                    logsContainer.innerHTML = '<div class="log-entry"><span class="log-message">No logs yet</span></div>';
                }
            } catch (error) {
                document.getElementById('logsContainer').innerHTML = '<div class="log-entry"><span class="log-message">[ERROR] Failed to load logs</span></div>';
            }
        }

        // Utility: Escape HTML
        function escapeHtml(text) {
            const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        // Initial load
        window.addEventListener('load', () => {
            updateStatus();
            loadLogs();

            autoRefreshInterval = setInterval(() => {
                updateStatus();
                loadLogs();
            }, 5000);
        });

        window.addEventListener('beforeunload', () => {
            if (autoRefreshInterval) clearInterval(autoRefreshInterval);
        });
    </script>
</body>
</html>
